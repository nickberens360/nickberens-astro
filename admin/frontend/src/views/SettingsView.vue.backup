<template>
  <v-container>
    <v-row>
      <v-col cols="12">
        <h1 class="text-h4 mb-6">
          <v-icon left>$settings</v-icon>
          System Settings
        </h1>
      </v-col>
    </v-row>

    <v-row>
      <v-col cols="12" md="8">
        <!-- Follow-up Questions Settings Card -->
        <v-card class="mb-6">
          <v-card-title>
            <v-icon left>$help-circle</v-icon>
            Follow-up Questions
          </v-card-title>

          <v-card-subtitle>
            Configure how follow-up questions are generated and displayed
          </v-card-subtitle>

          <v-card-text>
            <v-form ref="followupForm">
              <!-- Enable/Disable Toggle -->
              <v-switch
                v-model="followupSettings.enabled"
                label="Enable follow-up questions"
                color="primary"
                hide-details
                class="mb-4"
              ></v-switch>

              <div v-show="followupSettings.enabled" class="settings-section">
                <!-- Service Type Selection -->
                <v-select
                  v-model="followupSettings.service_type"
                  :items="serviceTypeOptions"
                  label="Generation Method"
                  prepend-icon="$brain"
                  hint="How follow-up questions are selected"
                  persistent-hint
                  class="mb-4"
                ></v-select>

                <!-- Maximum Questions -->
                <v-slider
                  v-model="followupSettings.max_questions"
                  :min="1"
                  :max="5"
                  :step="1"
                  label="Maximum Questions"
                  prepend-icon="$numeric"
                  thumb-label="always"
                  show-ticks="always"
                  tick-size="4"
                  class="mb-4"
                >
                  <template v-slot:append>
                    <v-text-field
                      v-model="followupSettings.max_questions"
                      type="number"
                      style="width: 60px"
                      density="compact"
                      hide-details
                      variant="outlined"
                    ></v-text-field>
                  </template>
                </v-slider>

                <!-- Question Categories -->
                <div class="mb-4">
                  <v-list-subheader class="pl-0">Question Categories</v-list-subheader>
                  <v-row>
                    <v-col cols="12" sm="4">
                      <v-checkbox
                        v-model="followupSettings.include_technical"
                        label="Technical"
                        color="primary"
                        hide-details
                      ></v-checkbox>
                    </v-col>
                    <v-col cols="12" sm="4">
                      <v-checkbox
                        v-model="followupSettings.include_personal"
                        label="Personal"
                        color="primary"
                        hide-details
                      ></v-checkbox>
                    </v-col>
                    <v-col cols="12" sm="4">
                      <v-checkbox
                        v-model="followupSettings.include_creative"
                        label="Creative"
                        color="primary"
                        hide-details
                      ></v-checkbox>
                    </v-col>
                  </v-row>
                </div>
              </div>
            </v-form>

            <!-- Status Messages -->
            <v-alert
              v-if="error"
              type="error"
              dismissible
              @click="error = ''"
              class="mt-4"
            >
              {{ error }}
            </v-alert>

            <v-alert
              v-if="success"
              type="success"
              dismissible
              @click="success = ''"
              class="mt-4"
            >
              {{ success }}
            </v-alert>
          </v-card-text>

          <v-card-actions>
            <v-spacer></v-spacer>
            <v-btn
              color="grey"
              variant="text"
              @click="resetToDefaults"
              :disabled="loading"
            >
              Reset to Defaults
            </v-btn>
            <v-btn
              color="primary"
              :disabled="loading"
              :loading="loading"
              @click="saveSettings"
            >
              Save Settings
            </v-btn>
          </v-card-actions>
        </v-card>

        <!-- Category Management Card -->
        <v-card class="mb-6">
          <v-card-title>
            <v-icon left>$format-list-group</v-icon>
            Manage Categories
          </v-card-title>

          <v-card-subtitle>
            Create and manage follow-up question categories
          </v-card-subtitle>

          <v-card-text>
            <v-row class="mb-4">
              <v-col cols="12">
                <v-btn
                  color="primary"
                  prepend-icon="$plus"
                  @click="showCategoryDialog = true"
                  :disabled="loading"
                  variant="elevated"
                >
                  Add New Category
                </v-btn>
              </v-col>
            </v-row>

            <v-data-table
              :headers="categoryHeaders"
              :items="categories"
              :loading="loading"
              item-value="id"
              class="elevation-1"
            >
              <template v-slot:item.icon="{ item }">
                <v-icon>${{ item.icon }}</v-icon>
              </template>
              
              <template v-slot:item.is_active="{ item }">
                <v-chip
                  :color="item.is_active ? 'success' : 'warning'"
                  size="small"
                  variant="flat"
                >
                  {{ item.is_active ? 'Active' : 'Inactive' }}
                </v-chip>
              </template>
              
              <template v-slot:item.actions="{ item }">
                <v-btn
                  icon="$edit"
                  size="small"
                  variant="text"
                  @click="editCategory(item)"
                  :disabled="loading"
                ></v-btn>
                <v-btn
                  icon="$delete"
                  size="small"
                  variant="text"
                  color="error"
                  @click="deleteCategory(item)"
                  :disabled="loading || ['technical', 'personal', 'creative'].includes(item.name)"
                ></v-btn>
              </template>
            </v-data-table>
          </v-card-text>
        </v-card>

        <!-- Question Management Card -->
        <v-card class="mb-6">
          <v-card-title>
            <v-icon left>$help-circle-outline</v-icon>
            Manage Follow-up Questions
          </v-card-title>

          <v-card-subtitle>
            Customize the follow-up questions shown to users
          </v-card-subtitle>

          <v-card-text>
            <v-tabs v-model="activeQuestionTab" bg-color="transparent">
              <v-tab 
                v-for="category in categories.filter(c => c.is_active)"
                :key="category.name"
                :value="category.name"
              >
                <v-icon left size="small">${{ category.icon }}</v-icon>
                {{ category.display_name }}
              </v-tab>
            </v-tabs>

            <v-tabs-window v-model="activeQuestionTab" class="mt-4">
              <v-tabs-window-item
                v-for="category in categories.filter(c => c.is_active)"
                :key="category.name"
                :value="category.name"
              >
                <div class="question-list">
                  <!-- ORIGINAL IMPLEMENTATION COMMENTED OUT FOR TESTING
                  <div v-if="questionItems[category] && questionItems[category].length > 0">
                    <draggable
                      v-model="questionItems[category]"
                      group="questions"
                      @end="onQuestionReorder"
                      handle=".drag-handle"
                      item-key="id"
                    >
                      <template #item="{element, index}">
                        <v-list-item :key="element.id" class="question-item">
                          <template v-slot:prepend>
                            <v-icon class="drag-handle">$drag-vertical</v-icon>
                          </template>
                          <v-list-item-title>
                            <v-text-field
                              v-model="element.text"
                              variant="outlined"
                              density="compact"
                              hide-details
                              @blur="validateQuestion(category, index)"
                              @input="syncQuestionText(category, index)"
                            ></v-text-field>
                          </v-list-item-title>
                          <template v-slot:append>
                            <v-btn
                              icon="$delete"
                              size="small"
                              variant="text"
                              color="error"
                              @click="removeQuestion(category, index)"
                            ></v-btn>
                          </template>
                        </v-list-item>
                      </template>
                    </draggable>
                  </div>
                  -->

                  <!-- NATIVE VUE DRAG AND DROP IMPLEMENTATION -->
                  <div class="native-drag-container" v-if="questionItems[category.name] && questionItems[category.name].length > 0">
                    <v-list>
                      <v-list-item 
                        v-for="(item, index) in questionItems[category.name]"
                        :key="item.id"
                        class="draggable-item"
                        draggable="true"
                        @dragstart="onDragStart($event, index)"
                        @dragend="onDragEnd($event)"
                        @dragover.prevent
                        @dragenter.prevent
                        @drop="onDrop($event, index, category.name)"
                      >
                        <template v-slot:prepend>
                          <v-icon class="drag-handle">$drag-vertical</v-icon>
                        </template>
                        <v-list-item-title>
                          <v-text-field
                            v-model="item.text"
                            variant="outlined"
                            density="compact"
                            hide-details
                            @blur="validateQuestion(category.name, index)"
                            @input="syncQuestionText(category.name, index)"
                          ></v-text-field>
                        </v-list-item-title>
                        <template v-slot:append>
                          <v-btn
                            icon="$delete"
                            size="small"
                            variant="text"
                            color="error"
                            @click="removeQuestion(category.name, index)"
                          ></v-btn>
                        </template>
                      </v-list-item>
                    </v-list>
                  </div>

                  <v-alert v-else type="info" variant="tonal" class="mb-4">
                    No custom questions for {{ category.display_name }}. Using default questions.
                  </v-alert>

                  <v-btn
                    variant="outlined"
                    prepend-icon="$plus"
                    @click="addQuestion(category.name)"
                    :disabled="loading || (questionItems[category.name] && questionItems[category.name].length >= 20)"
                    class="mt-2"
                  >
                    Add {{ category.display_name }} Question
                  </v-btn>
                </div>
              </v-tabs-window-item>
            </v-tabs-window>
          </v-card-text>

          <v-card-actions>
            <v-spacer></v-spacer>
            <v-btn
              color="grey"
              variant="text"
              @click="resetCustomQuestions"
              :disabled="loading"
            >
              Reset to Defaults
            </v-btn>
            <v-btn
              color="primary"
              :disabled="loading"
              :loading="loading"
              @click="saveCustomQuestions"
            >
              Save Questions
            </v-btn>
          </v-card-actions>
        </v-card>
      </v-col>

      <!-- Settings Info Sidebar -->
      <v-col cols="12" md="4">
        <v-card>
          <v-card-title>
            <v-icon left>$info</v-icon>
            Settings Information
          </v-card-title>

          <v-card-text>
            <div class="mb-4">
              <h4 class="text-subtitle-1 mb-2">Generation Methods</h4>
              <v-list density="compact">
                <v-list-item>
                  <v-list-item-title>Static</v-list-item-title>
                  <v-list-item-subtitle>Sequential rotation through predefined questions</v-list-item-subtitle>
                </v-list-item>
                <v-list-item>
                  <v-list-item-title>Dynamic</v-list-item-title>
                  <v-list-item-subtitle>Context-aware question selection</v-list-item-subtitle>
                </v-list-item>
                <v-list-item>
                  <v-list-item-title>Contextual</v-list-item-title>
                  <v-list-item-subtitle>AI-powered conversation analysis</v-list-item-subtitle>
                </v-list-item>
              </v-list>
            </div>

            <div class="mb-4">
              <h4 class="text-subtitle-1 mb-2">Question Categories</h4>
              <v-list density="compact">
                <v-list-item>
                  <v-list-item-title>Technical</v-list-item-title>
                  <v-list-item-subtitle>Development, technologies, coding</v-list-item-subtitle>
                </v-list-item>
                <v-list-item>
                  <v-list-item-title>Personal</v-list-item-title>
                  <v-list-item-subtitle>Experience, background, contact</v-list-item-subtitle>
                </v-list-item>
                <v-list-item>
                  <v-list-item-title>Creative</v-list-item-title>
                  <v-list-item-subtitle>Illustrations, art, design work</v-list-item-subtitle>
                </v-list-item>
              </v-list>
            </div>

            <v-alert
              type="info"
              variant="tonal"
              density="compact"
            >
              Changes take effect immediately for new queries. Existing cached responses are not affected.
            </v-alert>
          </v-card-text>
        </v-card>
      </v-col>
    </v-row>

    <!-- Category Dialog -->
    <v-dialog v-model="showCategoryDialog" max-width="500px">
      <v-card>
        <v-card-title>
          <span class="text-h5">{{ editingCategory ? 'Edit' : 'Add' }} Category</span>
        </v-card-title>

        <v-card-text>
          <v-form ref="categoryForm" @submit.prevent="saveCategoryDialog">
            <v-text-field
              v-model="dialogCategory.name"
              label="Category Name"
              hint="Machine name (lowercase, underscores only)"
              persistent-hint
              :rules="[categoryNameRule]"
              :disabled="editingCategory"
              variant="outlined"
              class="mb-3"
            ></v-text-field>

            <v-text-field
              v-model="dialogCategory.display_name"
              label="Display Name"
              hint="Human-readable name shown in UI"
              persistent-hint
              :rules="[v => !!v || 'Display name is required']"
              variant="outlined"
              class="mb-3"
            ></v-text-field>

            <v-textarea
              v-model="dialogCategory.description"
              label="Description"
              hint="Optional description of this category"
              persistent-hint
              variant="outlined"
              rows="2"
              class="mb-3"
            ></v-textarea>

            <v-text-field
              v-model="dialogCategory.icon"
              label="Icon"
              hint="Vuetify icon name (e.g., code, palette, account)"
              persistent-hint
              variant="outlined"
              class="mb-3"
            ></v-text-field>

            <v-text-field
              v-model.number="dialogCategory.sort_order"
              label="Sort Order"
              hint="Lower numbers appear first"
              persistent-hint
              type="number"
              variant="outlined"
              class="mb-3"
            ></v-text-field>

            <v-switch
              v-if="editingCategory"
              v-model="dialogCategory.is_active"
              label="Active"
              color="primary"
              hide-details
            ></v-switch>
          </v-form>
        </v-card-text>

        <v-card-actions>
          <v-spacer></v-spacer>
          <v-btn
            color="grey"
            variant="text"
            @click="closeCategoryDialog"
            :disabled="loading"
          >
            Cancel
          </v-btn>
          <v-btn
            color="primary"
            :loading="loading"
            @click="saveCategoryDialog"
          >
            {{ editingCategory ? 'Update' : 'Create' }}
          </v-btn>
        </v-card-actions>
      </v-card>
    </v-dialog>
  </v-container>
</template>

<script>
import { ref, reactive, onMounted } from 'vue'
import api from '@/services/api'

export default {
  name: 'SettingsView',
  components: {},
  setup() {
    const followupForm = ref(null)
    const loading = ref(false)
    const error = ref('')
    const success = ref('')

    // Question management
    const activeQuestionTab = ref('technical')
    const customQuestions = reactive({})
    // Wrapper for draggable component - needs objects with id
    const questionItems = reactive({})
    const defaultQuestions = ref({})

    // Category management
    const categories = ref([])
    const showCategoryDialog = ref(false)
    const editingCategory = ref(false)
    const dialogCategory = reactive({
      name: '',
      display_name: '',
      description: '',
      icon: 'help-circle',
      sort_order: 0,
      is_active: true
    })

    const categoryHeaders = [
      { title: 'Name', value: 'display_name', sortable: true },
      { title: 'Icon', value: 'icon', sortable: false },
      { title: 'Description', value: 'description', sortable: false },
      { title: 'Order', value: 'sort_order', sortable: true },
      { title: 'Status', value: 'is_active', sortable: true },
      { title: 'Actions', value: 'actions', sortable: false }
    ]

    const categoryNameRule = (v) => {
      if (!v) return 'Category name is required'
      if (!/^[a-z_][a-z0-9_]*$/.test(v)) return 'Use lowercase letters, numbers, and underscores only'
      if (v.length > 50) return 'Category name must be 50 characters or less'
      return true
    }

    const followupSettings = reactive({
      enabled: true,
      service_type: 'static',
      max_questions: 1,
      relevance_threshold: 0.7,
      include_technical: true,
      include_personal: true,
      include_creative: true,
      question_style: 'conversational'
    })

    const serviceTypeOptions = [
      { title: 'Static (Sequential)', value: 'static' },
      { title: 'Dynamic (Context-aware)', value: 'dynamic' },
      { title: 'Contextual (AI-powered)', value: 'contextual' }
    ]

    const loadSettings = async () => {
      try {
        loading.value = true
        error.value = ''

        // Load settings, questions, and categories concurrently
        const [settingsResponse, questionsResponse, categoriesResponse] = await Promise.all([
          api.getFollowupSettings(),
          api.getFollowupQuestions(),
          api.getFollowupCategories()
        ])

        Object.assign(followupSettings, settingsResponse)

        // Load categories first
        categories.value = categoriesResponse || []

        // Initialize questions for all categories
        for (const category of categories.value) {
          const categoryName = category.name
          customQuestions[categoryName] = questionsResponse.custom_questions?.[categoryName] || []
          
          // Convert to object format for draggable
          questionItems[categoryName] = customQuestions[categoryName].map((q, idx) => ({
            id: `${categoryName.substring(0, 4)}-${idx}`,
            text: q
          }))
        }

        // Store default questions for reference
        defaultQuestions.value = questionsResponse.default_questions

        console.log('Loaded follow-up settings:', settingsResponse)
        console.log('Loaded custom questions:', questionsResponse)
        console.log('Loaded categories:', categoriesResponse)
      } catch (err) {
        console.error('Failed to load settings:', err)
        error.value = err.response?.data?.detail || 'Failed to load settings'
      } finally {
        loading.value = false
      }
    }

    const saveSettings = async () => {
      try {
        loading.value = true
        error.value = ''
        success.value = ''

        const response = await api.updateFollowupSettings(followupSettings)

        if (response.success) {
          success.value = response.message || 'Settings saved successfully!'
          console.log('Settings saved:', response.settings)
        }
      } catch (err) {
        console.error('Failed to save settings:', err)
        error.value = err.response?.data?.detail || 'Failed to save settings'
      } finally {
        loading.value = false
      }
    }

    const resetToDefaults = async () => {
      try {
        loading.value = true
        error.value = ''
        success.value = ''

        const response = await api.resetFollowupSettings()

        if (response.success) {
          Object.assign(followupSettings, response.settings)
          success.value = 'Settings reset to defaults!'
          console.log('Settings reset:', response.settings)
        }
      } catch (err) {
        console.error('Failed to reset settings:', err)
        error.value = err.response?.data?.detail || 'Failed to reset settings'
      } finally {
        loading.value = false
      }
    }

    // Question management methods
    const addQuestion = (category) => {
      if (!questionItems[category]) {
        questionItems[category] = []
      }
      if (questionItems[category].length < 20) {
        const newId = `${category.substring(0, 4)}-${Date.now()}`
        questionItems[category].push({ id: newId, text: '' })
        if (!customQuestions[category]) {
          customQuestions[category] = []
        }
        customQuestions[category].push('')
      }
    }

    const removeQuestion = (category, index) => {
      if (questionItems[category]) {
        questionItems[category].splice(index, 1)
      }
      if (customQuestions[category]) {
        customQuestions[category].splice(index, 1)
      }
    }

    const validateQuestion = (category, index) => {
      if (questionItems[category] && questionItems[category][index]) {
        const question = questionItems[category][index].text.trim()
        if (question.length > 200) {
          questionItems[category][index].text = question.substring(0, 200)
          if (customQuestions[category]) {
            customQuestions[category][index] = question.substring(0, 200)
          }
        }
      }
    }

    const onQuestionReorder = () => {
      // Sync the reordered items back to customQuestions
      const category = activeQuestionTab.value
      if (questionItems[category]) {
        customQuestions[category] = questionItems[category].map(item => item.text)
      }
    }

    // Native drag and drop implementation
    let draggedIndex = null
    let draggedElement = null
    
    const onDragStart = (event, index) => {
      draggedIndex = index
      draggedElement = event.target
      event.dataTransfer.effectAllowed = 'move'
      event.target.style.opacity = '0.5'
    }
    
    const onDragEnd = (event) => {
      // Reset opacity when drag ends
      if (draggedElement) {
        draggedElement.style.opacity = '1'
        draggedElement = null
      }
      draggedIndex = null
    }
    
    const onDrop = (event, dropIndex, category) => {
      event.preventDefault()
      
      if (draggedIndex !== null && draggedIndex !== dropIndex) {
        const items = [...questionItems[category]]
        const draggedItem = items[draggedIndex]
        
        // Remove the dragged item
        items.splice(draggedIndex, 1)
        
        // Insert it at the new position
        items.splice(dropIndex, 0, draggedItem)
        
        // Update the reactive data
        questionItems[category] = items
        
        // Sync with customQuestions
        customQuestions[category] = items.map(item => item.text)
      }
    }

    const syncQuestionText = (category, index) => {
      if (questionItems[category] && questionItems[category][index]) {
        customQuestions[category][index] = questionItems[category][index].text
      }
    }

    const updateQuestion = (category, index, value) => {
      if (questionItems[category] && questionItems[category][index]) {
        questionItems[category][index].text = value
      }
      if (customQuestions[category] && customQuestions[category][index] !== undefined) {
        customQuestions[category][index] = value
      }
    }

    const saveCustomQuestions = async () => {
      try {
        loading.value = true
        error.value = ''
        success.value = ''

        // Sync questionItems to customQuestions before saving
        for (const category of categories.value) {
          const categoryName = category.name
          if (questionItems[categoryName]) {
            customQuestions[categoryName] = questionItems[categoryName].map(item => item.text)
          }
        }

        // Filter out empty questions and validate
        const questionsToSave = {}
        for (const [category, questions] of Object.entries(customQuestions)) {
          const validQuestions = questions
            .map(q => q.trim())
            .filter(q => q.length > 0 && q.length <= 200)
          if (validQuestions.length > 0) {
            questionsToSave[category] = validQuestions
          }
        }

        const response = await api.updateFollowupQuestions(questionsToSave)

        if (response.success) {
          success.value = 'Custom questions saved successfully!'
          // Update local data with validated questions
          for (const category of categories.value) {
            const categoryName = category.name
            customQuestions[categoryName] = response.custom_questions?.[categoryName] || []
            // Update questionItems too
            questionItems[categoryName] = customQuestions[categoryName].map((q, idx) => ({
              id: `${categoryName.substring(0, 4)}-${idx}`,
              text: q
            }))
          }
        }
      } catch (err) {
        console.error('Failed to save questions:', err)
        error.value = err.response?.data?.detail || 'Failed to save questions'
      } finally {
        loading.value = false
      }
    }

    const resetCustomQuestions = async () => {
      try {
        loading.value = true
        error.value = ''
        success.value = ''

        const response = await api.resetFollowupQuestions()

        if (response.success) {
          // Clear all custom questions for all categories
          for (const category of categories.value) {
            const categoryName = category.name
            customQuestions[categoryName] = []
            questionItems[categoryName] = []
          }
          success.value = 'Questions reset to defaults!'
        }
      } catch (err) {
        console.error('Failed to reset questions:', err)
        error.value = err.response?.data?.detail || 'Failed to reset questions'
      } finally {
        loading.value = false
      }
    }

    // Category management methods
    const editCategory = (category) => {
      editingCategory.value = true
      Object.assign(dialogCategory, category)
      showCategoryDialog.value = true
    }

    const deleteCategory = async (category) => {
      if (!confirm(`Are you sure you want to delete the category "${category.display_name}"?`)) {
        return
      }

      try {
        loading.value = true
        error.value = ''
        success.value = ''

        const response = await api.deleteFollowupCategory(category.id)

        if (response.success) {
          success.value = response.message || 'Category deleted successfully!'
          // Refresh categories list
          await loadCategories()
        }
      } catch (err) {
        console.error('Failed to delete category:', err)
        error.value = err.response?.data?.detail || 'Failed to delete category'
      } finally {
        loading.value = false
      }
    }

    const loadCategories = async () => {
      try {
        const categoriesResponse = await api.getFollowupCategories()
        categories.value = categoriesResponse || []
      } catch (err) {
        console.error('Failed to load categories:', err)
      }
    }

    const closeCategoryDialog = () => {
      showCategoryDialog.value = false
      editingCategory.value = false
      Object.assign(dialogCategory, {
        name: '',
        display_name: '',
        description: '',
        icon: 'help-circle',
        sort_order: 0,
        is_active: true
      })
    }

    const saveCategoryDialog = async () => {
      try {
        loading.value = true
        error.value = ''
        success.value = ''

        let response
        if (editingCategory.value) {
          // Update existing category
          response = await api.updateFollowupCategory(dialogCategory.id, {
            display_name: dialogCategory.display_name,
            description: dialogCategory.description || null,
            icon: dialogCategory.icon,
            sort_order: dialogCategory.sort_order,
            is_active: dialogCategory.is_active
          })
        } else {
          // Create new category
          response = await api.createFollowupCategory({
            name: dialogCategory.name,
            display_name: dialogCategory.display_name,
            description: dialogCategory.description || null,
            icon: dialogCategory.icon,
            sort_order: dialogCategory.sort_order
          })
        }

        if (response.success) {
          success.value = response.message || 'Category saved successfully!'
          closeCategoryDialog()
          // Refresh categories list
          await loadCategories()
        }
      } catch (err) {
        console.error('Failed to save category:', err)
        error.value = err.response?.data?.detail || 'Failed to save category'
      } finally {
        loading.value = false
      }
    }

    onMounted(() => {
      loadSettings()
    })

    return {
      followupForm,
      loading,
      error,
      success,
      followupSettings,
      serviceTypeOptions,
      loadSettings,
      saveSettings,
      resetToDefaults,
      // Question management
      activeQuestionTab,
      customQuestions,
      questionItems,
      defaultQuestions,
      addQuestion,
      removeQuestion,
      validateQuestion,
      onQuestionReorder,
      syncQuestionText,
      updateQuestion,
      saveCustomQuestions,
      resetCustomQuestions,
      // Native drag and drop
      onDragStart,
      onDragEnd,
      onDrop,
      // Category management
      categories,
      showCategoryDialog,
      editingCategory,
      dialogCategory,
      categoryHeaders,
      categoryNameRule,
      editCategory,
      deleteCategory,
      loadCategories,
      closeCategoryDialog,
      saveCategoryDialog
    }
  }
}
</script>

<style scoped>
.settings-section {
  padding-left: 16px;
  border-left: 2px solid rgba(var(--v-theme-primary), 0.3);
  margin-left: 8px;
}

.v-list-subheader {
  font-weight: 500;
  color: rgba(var(--v-theme-on-surface), 0.87);
}

/* Question management styles */
.question-list {
  min-height: 200px;
}

.question-item {
  border: 1px solid rgba(var(--v-theme-outline), 0.2);
  border-radius: 8px;
  margin-bottom: 8px;
  transition: all 0.2s ease;
}

.question-item:hover {
  border-color: rgba(var(--v-theme-primary), 0.5);
  box-shadow: 0 2px 8px rgba(var(--v-theme-primary), 0.1);
}

.drag-handle {
  cursor: grab;
  color: rgba(var(--v-theme-on-surface), 0.6);
}

.drag-handle:active {
  cursor: grabbing;
}

/* Native drag and drop styles */
.draggable-item {
  transition: all 0.2s ease;
  border: 1px solid rgba(var(--v-theme-outline), 0.2);
  border-radius: 8px;
  margin-bottom: 8px;
}

.draggable-item:hover {
  border-color: rgba(var(--v-theme-primary), 0.5);
  box-shadow: 0 2px 8px rgba(var(--v-theme-primary), 0.1);
}

.draggable-item[draggable="true"] {
  cursor: move;
}

.native-drag-container {
  min-height: 200px;
}
</style>