# Nick Berens Portfolio - Minimal Environment Configuration
# =========================================================
# Most settings are now managed via the admin dashboard.
# Only secrets and deployment-specific values need to be in .env

# =====================================
# REQUIRED SECRETS
# =====================================
# Get your API keys from:
# - Anthropic: https://console.anthropic.com/
# - Google: https://makersuite.google.com/app/apikey
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# =====================================
# OPTIONAL SECRETS
# =====================================
# GitHub token for git integration features (optional)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token

# IP hash salt for privacy compliance (required in production)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
IP_HASH_SALT=

# =====================================
# ADMIN CREDENTIALS
# =====================================
# Initial admin user credentials
# Change these immediately after first login!
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_me_immediately

# =====================================
# DEPLOYMENT
# =====================================
# Environment: development or production
ENVIRONMENT=development

# Public URLs (update for your deployment)
PUBLIC_API_URL=http://localhost:8000
PUBLIC_GITHUB_USERNAME=your_github_username
PUBLIC_GITHUB_REPO=your_repo_name

# Google Analytics (optional)
PUBLIC_GA_TRACKING_ID=

# =====================================
# NOTES
# =====================================
# All other settings are now managed through the admin dashboard:
# - LLM models and configuration
# - Search and retrieval settings
# - RAG configuration
# - Feature flags
# - Performance tuning
# - Database settings
#
# Access the admin dashboard at: http://localhost:8000/admin
# (or your PUBLIC_API_URL/admin in production)
#
# After deployment:
# 1. Log in to the admin dashboard
# 2. Review and adjust settings as needed
# 3. Changes take effect immediately without restart