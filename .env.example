# GitHub API Configuration
# -----------------------
# Personal access token for GitHub API (keep this private, do not prefix with PUBLIC_)
GITHUB_TOKEN=your_github_personal_access_token

# Public GitHub information (accessible in browser, prefix with PUBLIC_)
PUBLIC_GITHUB_USERNAME=your_github_username
PUBLIC_GITHUB_REPO=your_github_repository_name
GOOGLE_API_KEY=your_google_api_key

# Backend API Configuration (FastAPI)
# -----------------------------------
# Environment and security (production should set these explicitly)
ENVIRONMENT=development            # production|development
ENV=development                    # production|development (used for strict checks)
LOG_LEVEL=INFO                     # DEBUG|INFO|WARNING|ERROR
RATE_LIMIT=5/minute                # e.g., 10/minute in production
CORS_ORIGINS=                      # CSV of allowed origins (https URLs)
IP_HASH_SALT=                      # REQUIRED in production; leave blank for dev (auto-generated)
EXCLUDED_IPS=                      # CSV of IPs to exclude from logging (optional)
FORCE_REBUILD_DATA=false           # If true, force reindex of knowledge on next start

# Query logs are stored in SQLite database (backend/logs/rag_monitoring.db)
# Query logs use session-based authentication through the admin dashboard

# LLM Models and Providers
PRIMARY_LLM=claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/embedding-001

# Provider API keys (keep private; do not prefix with PUBLIC_)
ANTHROPIC_API_KEY=your_anthropic_key
# Google Generative AI SDK reads GOOGLE_API_KEY above

# Request/caching behavior
REQUEST_TIMEOUT=30                 # seconds
ENABLE_CACHING=true
CACHE_TTL=3600                     # seconds

# Search configuration
SEARCH_THRESHOLD=55                # 0..100 (higher = stricter)
MAX_RESULTS=15
ILLUSTRATIONS_PATH=backend/knowledge/illustrations.json

# Follow-up question configuration
FOLLOWUP_MODE=pre_generated        # pre_generated|optimized|static
ENABLE_FOLLOWUP_PREGENERATION=true # control cold-start cost
FOLLOWUP_USE_LLM_ENHANCEMENT=false # enable LLM-enhanced followups (may cause timeouts)
FOLLOWUP_VALIDATION_SCORE_THRESHOLD=0.5

# RAG Configuration (placeholders; safe defaults)
# ------------------------------------------------
# Retrieval diversity via Maximal Marginal Relevance (MMR). Set to 'true' to enable.
RAG_USE_MMR=false
# Top-k results returned after filtering/reranking.
RAG_K=8
# Candidate pool size MMR samples from (must be >= k).
RAG_FETCH_K=24
# MMR diversity vs similarity trade-off (0..1). Higher -> more diversity.
RAG_LAMBDA=0.5
# Distance threshold for filtering similarity_search_with_score (smaller is more similar; 0..1 typical).
RAG_SCORE_THRESHOLD=0.2

# Directories to index (CSV). Non-existent paths are ignored.
RAG_INDEX_DIRS=backend/knowledge,public
# Enable physical deletion of old vectors for changed/removed files (guarded by SAFE_DELETE initially).
RAG_ENABLE_DELETE=false
# Log intended deletions without executing them; set to 'false' after verifying logs.
RAG_SAFE_DELETE=true

# Chunking configuration
# Use heading-aware splitters for Markdown/HTML when 'true'; falls back to recursive splitter when 'false'.
RAG_USE_HEADING_SPLITTER=false
# Default chunk size and overlap for unknown extensions.
RAG_CHUNK_DEFAULT=1000
RAG_CHUNK_OVERLAP_DEFAULT=150
# Per-extension overrides in the form size:overlap
RAG_CHUNK_PDF=1200:200
RAG_CHUNK_MD=800:120
RAG_CHUNK_HTML=1000:150
