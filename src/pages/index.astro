---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.vue';
import PageSection from '../components/PageSection.vue';
import AnnoyingEyelash from '../components/AnnoyingEyelash.vue';
import {terminalInputValue} from '../stores/ui';

// Get the initial value for server-side rendering
const initialCurseWord = terminalInputValue.get();
---

<Layout
    title="Nick Berens | Sh00t"
    description="Nick Berens - Frontend Developer"
>
  <AnnoyingEyelash
    client:load
    :initial-x="50"
    :initial-y="150"
    :opacity="0.5"
    :size="20"
  />
  <HeroBanner
      data-section-color="#d3a6fe"
      client:load
  >
    <p slot="content">
      <a
          href="#interview"
          style="color: blue"
      ><strong>( I didn't get the job )</strong></a>
    </p>
  </HeroBanner>
  <PageSection
      id="interview"
      data-section-color="yellow"
      background-color="yellow"
      width="1200"
      full-height
  >
    <h2 class="text-hero">It's true.</h2>
    <p class="text-xl">
      <span class="font-bold">Interviewer</span>
      : What do you value most in your teammates?
    </p>
    <p class="text-xl">
      <span class="font-bold">Dummy</span>
      : I value a healthy team culture and working with passionate people that love building cool
      <span class="highlight">bad&nbsp;word</span>
      !
    </p>
    <p class="text-md text-center font-bold">*oops</p>
  </PageSection>

  <PageSection
      id="recruiter"
      data-section-color="lightblue"
      background-color="lightblue"
      data-has-terminal-input="false"
      width="1200"
      full-height
  >
    <h2 class="text-hero">Note from my recruiter.</h2>
    <p class="text-xl">"They thought you had a great skill set for the position, but because of the
      <span class="highlight">bad&nbsp;word</span>
      you
      wouldn't be a good fit culturally."
    </p>
    <p class="font-bold">Love, Jacob the Recruiter</p>
  </PageSection>

  <PageSection
      data-section-color="lightgreen"
      background-color="lightgreen"
      width="1200"
      full-height
  >
    <h2 class="text-hero">NOW LET ME BE CLEAR.</h2>
    <p class="text-fluid-lg">I totally get that this was on me, and I understand where they’re coming from. I have no
      hard feelings towards the company nor their values.</p>
    <p class="text-lg ">I was definitely bummed I didn’t get the position. It really felt like a good fit, and the
      person who interviewed me was super cool.</p>
    <p class="text-lg">Honestly, I’m just disappointed in myself. I tend to drop a
      <span class="highlight">bad word</span>
      when I get really excited about something.
    </p>
  </PageSection>

  <PageSection
      id="contact"
      data-section-color="black"
      data-section-theme="dark"
      background-color="black"
      width="1200"
      full-height
  >
    <div>
      <h2 class="text-hero">But...</h2>
      <p class="text-fluid-lg text-wrap">If you're looking for a passionate Javascript, Vue, Nuxt, UI, UX, Astro,
        WordPress, Prismic, What-else-you-got frontend developer with 14 years of experience who says a
        <span class="highlight-yellow">bad&nbsp;word</span>
        every now and then, hit me up!
      </p>
      <div class="text-center">
        <a
            class="text-fluid-md"
            href="mailto:nickberens360@gmail.com"
            style="color: #82aaff"
        >nickberens360@gmail.com
        </a>
      </div>

    </div>
  </PageSection>
</Layout>
