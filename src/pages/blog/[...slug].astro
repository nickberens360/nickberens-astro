---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageSection from '../../components/PageSection.vue';
import BlogPostHeader from '../../components/blog/BlogPostHeader.vue';
import ContentPrompt from '../../components/blog/ContentPrompt.vue';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description}>
  <PageSection
    data-section-color={entry.data.backgroundColor || "white"}
    data-section-theme={entry.data.theme || "light"}
    background-color={entry.data.backgroundColor || "white"}
    full-height
  >
    <article>
      <BlogPostHeader
        title={entry.data.title}
        pubDate={entry.data.pubDate}
        author={entry.data.author}
        tags={entry.data.tags}
        theme={entry.data.theme || 'light'}
        client:load
        class="mb-16"
      />

      {entry.data.aiPrompt && (
        <ContentPrompt
          aiPrompt={entry.data.aiPrompt}
          theme={entry.data.theme || 'light'}
          client:load
        />
      )}

      <div class={`content ${(entry.data.theme || 'light') === 'light' ? 'theme-light' : 'theme-dark'}`}>
        <Content />
      </div>
    </article>
  </PageSection>
</Layout>

<script>
  // Copy button for accordions written as <details data-copy> in post markdown.
  // Copies the code block if there is one, otherwise the accordion's text without its heading.
  document.querySelectorAll('.content details[data-copy]').forEach((details) => {
    const summary = details.querySelector('summary');
    if (!summary) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = 'Copy';
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      const pre = details.querySelector('pre');
      let text = '';
      if (pre) {
        text = pre.textContent ?? '';
      } else {
        const wasOpen = details.open;
        details.open = true;
        text = Array.from(details.children)
          .filter((el) => el.tagName !== 'SUMMARY')
          .map((el) => (el as HTMLElement).innerText)
          .join('\n\n');
        details.open = wasOpen;
      }
      try {
        await navigator.clipboard.writeText(text.trim());
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
    summary.appendChild(button);
  });
</script>

<style>
  .content {
    line-height: 1.6;
    max-width: 800px;
    margin: auto;
  }

  .content :global(h2) {
    font-size: var(--font-size-xl);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .content :global(h3) {
    font-size: var(--font-size-lg);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
  }
  .content :global(pre) {
    padding: 1rem;
    border-radius: 0.5rem;
  }

  /* Accordions (<details>) in post content */
  .content :global(details) {
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.55);
  }

  .content :global(summary) {
    cursor: pointer;
    padding-right: 5rem;
  }

  .content :global(details[open] > summary) {
    margin-bottom: 1rem;
  }

  .content :global(details pre) {
    overflow-x: auto;
  }

  .content :global(.copy-btn) {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    background: #fff;
    color: #333;
    cursor: pointer;
  }

  .theme-dark :global(details) {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.25);
  }

  /* Theme-based text colors */
  .theme-light {
    color: #333333;
  }

  .theme-light :global(h1),
  .theme-light :global(h2),
  .theme-light :global(h3),
  .theme-light :global(h4),
  .theme-light :global(h5),
  .theme-light :global(h6) {
    color: #1a1a1a;
  }

  .theme-light :global(a) {
    color: #0066cc;
  }

  .theme-light :global(a:hover) {
    color: #004499;
  }

  .theme-dark {
    color: #e0e0e0;
  }

  .theme-dark :global(h1),
  .theme-dark :global(h2),
  .theme-dark :global(h3),
  .theme-dark :global(h4),
  .theme-dark :global(h5),
  .theme-dark :global(h6) {
    color: #ffffff;
  }

  .theme-dark :global(a) {
    color: #66b3ff;
  }

  .theme-dark :global(a:hover) {
    color: #99ccff;
  }

</style>
